// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  password      String
  phone         String?   @unique
  phoneVerified Boolean   @default(false)
  walletBalance Decimal   @default(0) @db.Decimal(10, 2)
  role          Role      @default(USER)
  kycVerified   Boolean   @default(false)
  kycDocuments  Json?
  isActive      Boolean   @default(true)
  lastActive    DateTime? @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  gameProfiles    GameProfile[]
  registrations   Registration[]
  transactions    Transaction[]
  accounts        Account[]
  sessions        Session[]
  fines           Fine[]
  disputes        Dispute[]
  sentNotifications NotificationHistory[] @relation("SentBy")
  receivedNotifications NotificationHistory[] @relation("ReceivedBy")

  @@index([email])
  @@index([username])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GameProfile {
  id             String   @id @default(cuid())
  userId         String
  gameName       String
  inGameId       String
  inGameUsername String
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameName])
  @@index([userId])
}

model Tournament {
  id          String            @id @default(cuid())
  game        String
  title       String
  description String?           @db.Text
  image       String
  entryFee    Decimal           @db.Decimal(10, 2)
  prizePool   Decimal           @db.Decimal(10, 2)
  maxPlayers  Int
  minPlayers  Int               @default(2)
  mode        TournamentMode
  status      TournamentStatus  @default(UPCOMING)
  startTime   DateTime
  endTime     DateTime?
  roomId      String?
  roomPassword String?
  rules       Json?
  prizeDistribution Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  registrations Registration[]

  @@index([game])
  @@index([status])
  @@index([startTime])
}

model Registration {
  id            String            @id @default(cuid())
  userId        String
  tournamentId  String
  paymentStatus PaymentStatus     @default(PENDING)
  paymentId     String?
  inGameId      String?           // Player's in-game ID for verification
  inGameUsername String?          // Player's IGN for verification
  rank          Int?
  kills         Int?
  points        Int?
  winnings      Decimal?          @db.Decimal(10, 2)
  resultProof   String?           // Screenshot URL
  verifiedInRoom Boolean          @default(false) // Admin marks as verified
  status        RegistrationStatus @default(REGISTERED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
  @@index([userId])
  @@index([tournamentId])
  @@index([status])
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  type            TransactionType
  amount          Decimal           @db.Decimal(10, 2)
  status          TransactionStatus @default(PENDING)
  razorpayOrderId String?
  razorpayPaymentId String?
  razorpaySignature String?
  description     String?
  reason          String?           // For fines/refunds
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// Enums
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  TOURNAMENT_MANAGER
  SUPPORT
  MARKETING
}

enum TournamentMode {
  SOLO
  DUO
  SQUAD
}

enum TournamentStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RegistrationStatus {
  REGISTERED
  PLAYING
  COMPLETED
  DISQUALIFIED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TOURNAMENT_FEE
  TOURNAMENT_WINNING
  REFUND
  FINE
  PROMOTIONAL_EXPENSE
  REFERRAL_BONUS
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Ad {
  id              String      @id @default(cuid())
  title           String
  mediaUrl        String
  mediaType       AdMediaType
  placement       AdPlacement
  redirectUrl     String?
  openInNewTab    Boolean     @default(true)
  priority        Int         @default(0)
  isActive        Boolean     @default(true)
  startDate       DateTime
  expiryDate      DateTime
  deviceTarget    DeviceTarget @default(ALL)
  impressions     Int         @default(0)
  clicks          Int         @default(0)
  maxImpressions  Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([isActive])
  @@index([placement])
  @@index([startDate])
  @@index([expiryDate])
  @@index([priority])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  type          CouponType
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  scope         CouponScope
  gameType      String?      // For GAME scope
  tournamentId  String?      // For TOURNAMENT scope
  minAmount     Decimal?     @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  usageLimit    Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  validFrom     DateTime     @default(now())
  validUntil    DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  usages CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([validUntil])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  discount  Decimal  @db.Decimal(10, 2)
  usedAt    DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

model Fine {
  id          String     @id @default(cuid())
  userId      String
  amount      Decimal    @db.Decimal(10, 2)
  reason      String     @db.Text
  evidence    String?    // Screenshot/proof URL
  tournamentId String?
  status      FineStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispute Dispute?

  @@index([userId])
  @@index([status])
}

model Dispute {
  id            String        @id @default(cuid())
  fineId        String        @unique
  userId        String
  justification String        @db.Text
  evidence      String?       // User's proof
  status        DisputeStatus @default(PENDING)
  reviewedBy    String?       // Admin ID
  reviewNotes   String?       @db.Text
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  fine Fine   @relation(fields: [fineId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  name        String
  title       String
  message     String   @db.Text
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model NotificationHistory {
  id          String              @id @default(cuid())
  title       String
  message     String              @db.Text
  targetType  NotificationTarget
  targetFilter Json?              // Stores filter criteria
  sentBy      String
  recipientId String?             // For individual notifications
  totalSent   Int                 @default(0)
  sentAt      DateTime            @default(now())

  sender    User  @relation("SentBy", fields: [sentBy], references: [id], onDelete: Cascade)
  recipient User? @relation("ReceivedBy", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([sentBy])
  @@index([recipientId])
  @@index([sentAt])
}

model AdminActivity {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  targetType  String?  // Tournament, User, Coupon, etc.
  targetId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

enum CouponType {
  FIRST_TIME
  PROMOTIONAL
  REFERRAL
  SPECIAL_EVENT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  PLATFORM_WIDE
  GAME_SPECIFIC
  TOURNAMENT_SPECIFIC
}

enum FineStatus {
  ACTIVE
  DISPUTED
  WAIVED
  PAID
}

enum DisputeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationTarget {
  ALL_USERS
  GAME_SPECIFIC
  ACTIVE_USERS
  INACTIVE_USERS
  WALLET_BASED
  TOURNAMENT_PARTICIPANTS
  CUSTOM
}

enum AdMediaType {
  IMAGE
  VIDEO
}

enum AdPlacement {
  HERO
  BANNER
  POPUP
}

enum DeviceTarget {
  ALL
  MOBILE
  DESKTOP
}
